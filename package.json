{
  "name": "ms-seed-node",
  "version": "1.0.0",
  "description": "Azure Functions webpack sample for the Serverless framework using Typescript",
  "scripts": {
    "test": "jest --verbose",
    "test:cov": "npm run test -- --coverage",
    "test:watch": "npm run test -- --watch",
    "prestart": "sls offline build",
    "lint": "eslint ./src/**/*.ts",
    "start": "SLS_DEBUG=* sls offline -a=--verbose --env local",
    "migrate:up": "migrate-mongo up",
    "migrate:down": "migrate-mongo down",
    "migrate:create": "migrate-mongo create",
    "build": "sls offline build",
    "deploy": "SLS_DEBUG=* sls deploy"
  },
  "keywords": [
    "azure",
    "serverless"
  ],
  "engines": {
    "node": "=v12.16.3"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged && npm run build",
      "pre-push": "npm run test:cov"
    }
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write",
      "git add"
    ]
  },
  "dependencies": {
    "@hapi/joi": "~15",
    "azure-aws-serverless-express": "^0.1.5",
    "body-parser": "^1.19.0",
    "express": "^4.17.1",
    "express-joi-validation": "4.0.0",
    "joi-extract-type": "^15.0.8",
    "mongoose": "^5.10.3"
  },
  "devDependencies": {
    "@azure/functions": "^1.0.3",
    "@types/express": "^4.17.8",
    "@types/hapi__joi": "~15",
    "@types/jest": "^26.0.13",
    "@types/mongoose": "^5.7.36",
    "@types/node": "^13.1.8",
    "@types/supertest": "^2.0.10",
    "@typescript-eslint/eslint-plugin": "^4.1.0",
    "@typescript-eslint/parser": "^4.1.0",
    "copy-webpack-plugin": "^6.2.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^6.10.0",
    "eslint-plugin-prettier": "^3.1.2",
    "expose-gc": "^1.0.0",
    "faker": "^4.1.0",
    "fork-ts-checker-webpack-plugin": "^3.0.1",
    "husky": "^4.3.0",
    "jest": "^24.8.0",
    "jest-date-mock": "^1.0.7",
    "lint-staged": "^8.2.1",
    "migrate-mongo": "^8.1.1",
    "mongodb-memory-server": "^11.1.0",
    "nodemon": "^1.19.1",
    "prettier": "^1.19.1",
    "serverless": "^4.36.1",
    "serverless-azure-functions": "^2.0.0",
    "serverless-webpack": "^5.3.1",
    "sonarqube-scanner": "^2.6.0",
    "standard-version": "^9.0.0",
    "supertest": "^4.0.2",
    "ts-jest": "^26.3.0",
    "ts-loader": "^6.2.1",
    "ts-node": "^8.3.0",
    "typescript": "^4.0.0",
    "webpack": "^5.94.0",
    "webpack-cli": "^3.3.12",
    "webpack-node-externals": "^1.7.2"
  }
}
