{
  "$schema": "http://json.schemastore.org/proxies",
  "proxies": {
    "assets": {
      "matchCondition": {
        "route": "/assets/{*restOfPath}",
        "methods": [
          "GET",
          "OPTIONS"
        ]
      },
      "backendUri": "https://%STORAGE_ACCOUNT_NAME%.blob.core.windows.net/assets/{restOfPath}"
    }
  }
}